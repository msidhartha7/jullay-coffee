---
import '../styles/tokens.css';
import '../styles/global.css';
import Defs from '../components/art/Defs.astro';
import { cafe } from '../data/cafe';

interface Props { title?: string; description?: string; theme?: 'cream' | 'forest'; bodyClass?: string }
const {
  title = `${cafe.name}. ${cafe.tagline}`,
  description = 'Jullay is hello in Ladakhi. Walk in, pick a mug, order at the bar. No hype. Just coffee.',
  theme = 'cream',
  bodyClass = '',
} = Astro.props;
const og = new URL('/og.jpg', Astro.site).toString();
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6b7830" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class={bodyClass}>
    <Defs />
    <slot />
  </body>
</html>
