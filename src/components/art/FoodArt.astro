---
// Engraved food, one small object on a plate. viewBox 160 x 120.
interface Props { art: 'croissant' | 'loaf' | 'sandwich' | 'cookie' }
const { art } = Astro.props;
const INK = '#1c1a14';
---
<svg class="food-art" viewBox="0 0 160 120" aria-hidden="true" focusable="false">
  <ellipse cx="80" cy="96" rx="70" ry="16" fill="#fefdfb" stroke={INK} stroke-width="1.6" />
  <ellipse cx="80" cy="94" rx="48" ry="9" fill="none" stroke={INK} stroke-width=".8" />
  <path d="M30 104 Q80 116 130 104" fill="none" stroke={INK} stroke-width=".7" />

  {art === 'croissant' && (
    <g stroke={INK} stroke-width="1.6" stroke-linejoin="round">
      <path d="M22 84 C26 56 52 38 80 38 C108 38 134 56 138 84 C128 78 118 76 112 80 C104 70 92 66 80 66 C68 66 56 70 48 80 C42 76 32 78 22 84 Z" fill="#b49a7c" />
      <path d="M22 84 C26 56 52 38 80 38 C108 38 134 56 138 84 C128 78 118 76 112 80 C104 70 92 66 80 66 C68 66 56 70 48 80 C42 76 32 78 22 84 Z" fill="url(#jh)" opacity=".45" stroke="none" />
      <path d="M48 80 C46 64 52 50 62 44 M80 66 C78 56 78 46 80 38 M112 80 C114 64 108 50 98 44" fill="none" />
      <path d="M62 44 C58 54 58 64 62 72 M98 44 C102 54 102 64 98 72" fill="none" stroke-width="1" />
      <path d="M86 44 C94 46 100 50 104 56 M70 44 C62 46 56 50 52 56" fill="none" stroke="#f8eacf" stroke-width="1.4" />
    </g>
  )}

  {art === 'loaf' && (
    <g stroke={INK} stroke-width="1.6" stroke-linejoin="round">
      <path d="M40 88 V52 C40 34 120 34 120 52 V88 Z" fill="#b49a7c" />
      <path d="M40 52 C40 34 120 34 120 52 C120 46 40 46 40 52 Z" fill="#3c4128" />
      <path d="M40 52 C40 34 120 34 120 52" fill="url(#jh-dense)" opacity=".6" stroke="none" />
      <path d="M46 56 V86 H114 V56" fill="#e0cfbc" stroke-width="1" />
      <g fill={INK} stroke="none">
        {Array.from({ length: 26 }, (_, i) => <circle cx={50 + ((i * 29) % 60)} cy={60 + ((i * 17) % 24)} r={(i % 3) * 0.5 + 0.8} />)}
      </g>
      <path d="M94 56 V86 H114 V56 Z" fill="url(#jh)" opacity=".5" stroke="none" />
    </g>
  )}

  {art === 'sandwich' && (
    <g stroke={INK} stroke-width="1.6" stroke-linejoin="round">
      <path d="M30 86 L80 40 L130 86 Z" fill="#e0cfbc" />
      <path d="M30 86 L80 40 L130 86 Z" fill="url(#jh-fine)" opacity=".5" />
      <path d="M36 80 Q46 74 54 80 T72 80 T90 80 T108 80 T124 80" fill="none" stroke="#576544" stroke-width="5" />
      <path d="M36 80 Q46 74 54 80 T72 80 T90 80 T108 80 T124 80" fill="none" stroke-width="1" />
      <path d="M30 86 L80 40" fill="none" stroke-width="2.4" />
      <path d="M52 66 h56" stroke="#f8eacf" stroke-width="5" />
      <path d="M52 66 h56" stroke-width=".8" />
      <path d="M88 52 L118 80 L130 86 L80 40 Z" fill="url(#jh)" opacity=".5" stroke="none" />
    </g>
  )}

  {art === 'cookie' && (
    <g stroke={INK} stroke-width="1.6">
      <path d="M80 34 C110 32 126 52 124 70 C122 90 104 100 80 98 C54 98 36 86 36 66 C36 46 54 34 80 34 Z" fill="#b49a7c" />
      <path d="M100 40 C118 50 126 70 116 88 C108 96 96 98 88 98 C104 86 110 64 100 40 Z" fill="url(#jh)" opacity=".55" stroke="none" />
      <g fill={INK} stroke="none">
        <path d="M60 52 l8 -2 l2 7 l-7 3 z" /><path d="M86 48 l7 2 l-1 7 l-8 -1 z" /><path d="M70 74 l9 1 l-2 7 l-7 -2 z" />
        <path d="M100 66 l6 4 l-4 6 l-6 -4 z" /><path d="M50 72 l5 2 l-2 5 l-5 -2 z" />
      </g>
      <path d="M58 86 l10 -6 M96 84 l6 -10 M74 44 l6 6" fill="none" stroke-width="1" />
    </g>
  )}
</svg>

<style>
  .food-art { display: block; width: 100%; height: auto; }
</style>
