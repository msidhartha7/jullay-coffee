---
// Shared engraving: hatch patterns used by every illustration on the page.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="jh" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="4" stroke="#1c1a14" stroke-width=".9" />
    </pattern>
    <pattern id="jh-fine" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="3" stroke="#1c1a14" stroke-width=".45" />
    </pattern>
    <pattern id="jh-x" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="0" x2="0" y2="4" stroke="#1c1a14" stroke-width=".9" />
    </pattern>
    <pattern id="jh-dense" width="2.4" height="2.4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="2.4" stroke="#1c1a14" stroke-width="1" />
    </pattern>
    <pattern id="jh-h" width="8" height="5" patternUnits="userSpaceOnUse">
      <line x1="0" y1="2.5" x2="8" y2="2.5" stroke="#1c1a14" stroke-width=".5" />
    </pattern>
    <pattern id="jh-v" width="5" height="8" patternUnits="userSpaceOnUse">
      <line x1="2.5" y1="0" x2="2.5" y2="8" stroke="#1c1a14" stroke-width=".5" />
    </pattern>
    <pattern id="jh-cream" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="#f8eacf" stroke-width=".7" />
    </pattern>
    <!-- wood grain: wavy horizontal lines -->
    <pattern id="jh-wood" width="120" height="10" patternUnits="userSpaceOnUse">
      <path d="M0 3 C20 1 40 5 60 3 S100 1 120 3" fill="none" stroke="#1c1a14" stroke-width=".6" />
      <path d="M0 8 C30 9 50 6 80 8 S110 9 120 8" fill="none" stroke="#1c1a14" stroke-width=".4" />
    </pattern>
  </defs>
</svg>
