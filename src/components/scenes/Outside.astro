---
import Shopfront from '../art/Shopfront.astro';
import { cafe } from '../../data/cafe';
---
<section id="outside" class="outside" aria-label="Outside the cafe">
  <div class="outside-stage">
    <div class="outside-cam" data-cam>
      <Shopfront id="shopfront" />
    </div>
    <p class="outside-overline t-overline">{cafe.tagline}</p>
    <button type="button" class="walk-in" data-walk-in>
      <span class="sr-only">Walk in</span>
    </button>
    <p class="scroll-hint t-eyebrow" aria-hidden="true">Scroll to walk in</p>

    <div class="hello" data-hello>
      <p class="hello-word">{cafe.greeting.word}</p>
      <p class="t-tagline hello-meaning">{cafe.greeting.meaning}</p>
      <a class="hello-hint" href="#mugs" data-come-in>Come in <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .outside { position: relative; background: var(--jullay-forest); }
  .outside-stage { position: relative; height: 100svh; overflow: hidden; contain: paint; }
  .outside-cam { position: absolute; inset: 0; will-change: transform; transform-origin: 50% 65.5%; }
  .outside-overline {
    position: absolute; top: 84px; left: 0; right: 0; text-align: center; color: var(--jullay-ink);
  }
  .walk-in {
    position: absolute; left: 50%; top: 65.5%; width: min(30vw, 46svh); height: 46svh;
    transform: translate(-50%, -50%); cursor: pointer;
  }
  .walk-in:focus-visible { outline: 2px solid var(--jullay-milk); outline-offset: 4px; }
  .scroll-hint {
    position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: var(--jullay-ink);
    animation: nudge 2.4s ease-in-out infinite;
  }
  /* faded out once you start walking in: stop animating it */
  .outside-stage:global(.is-walking) .scroll-hint { animation-play-state: paused; }
  @keyframes nudge { 50% { transform: translateY(5px); } }

  .hello {
    display: grid; place-content: center; gap: var(--space-2); text-align: center;
    padding: var(--space-4) var(--space-3); background: var(--jullay-forest); color: var(--jullay-cream);
    min-height: 60svh; contain: paint;
  }
  .hello-word { font: 800 clamp(88px, 18vw, 220px) / 0.9 var(--font-display); letter-spacing: -0.03em; color: var(--jullay-milk); }
  .hello-meaning { max-width: 28ch; margin: 0 auto; }
  .hello-hint {
    justify-self: center; display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; margin-top: var(--space-3);
    font: 600 13px / 1 var(--font-sans); letter-spacing: 0.32em; text-transform: uppercase; text-decoration: none;
    color: var(--jullay-forest); background: var(--jullay-cream);
  }
  .hello-hint span { letter-spacing: 0; font-size: 18px; transition: transform .25s; }
  .hello-hint:hover span { transform: translateX(4px); }
  .hello-hint:focus-visible { outline: 2px solid var(--jullay-milk); outline-offset: 3px; }

  :global(html.js) .hello { position: absolute; inset: 0; opacity: 0; pointer-events: none; min-height: 0; }
</style>
