---
const zones = [
  { id: 'caffeine', label: 'Caffeine', target: 'mugs' },
  { id: 'carbs', label: 'Carbs', target: 'carbs' },
  { id: 'chapters', label: 'Chapters', target: 'chapters' },
  { id: 'wall', label: 'The wall', target: 'wall' },
];
---
<header class="topbar">
  <a class="skip" href="#room">Skip to the cafe</a>
  <a href="#outside" class="topbar-logo" aria-label="Jullay Coffee, back to the door">
    <span class="logo" aria-hidden="true"></span>
  </a>
  <nav class="zones" aria-label="Rooms">
    {zones.map((z) => (
      <a class="plaque" href={`#${z.target}`} data-zone-link={z.id} data-target={z.target}>{z.label}</a>
    ))}
  </nav>
  <div class="topbar-right">
    <span class="tag open-tag" data-open-tag>Open now</span>
    <button class="sound-toggle" type="button" aria-pressed="false" data-sound>Sound off</button>
    <a class="menu-link" href="/menu" data-open-menu="0">Menu</a>
  </div>
</header>

<style>
  .topbar {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: 56px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-2);
    padding: 0 var(--space-3); background: var(--jullay-olive); color: var(--jullay-milk);
  }
  .topbar-logo { width: 92px; color: var(--jullay-milk); }
  .zones { display: flex; gap: var(--space-1); }
  .plaque {
    display: inline-flex; align-items: center; height: 32px; padding: 0 14px;
    background: var(--jullay-ink); color: var(--jullay-milk); text-decoration: none;
    font: 700 13px / 1 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase;
    box-shadow: inset 0 0 0 1.5px var(--jullay-ink);
    transition: background-color .2s, color .2s;
  }
  .plaque:hover { background: var(--jullay-forest); }
  .plaque[aria-current="true"] { background: var(--jullay-cream); color: var(--jullay-ink); }
  .topbar-right { display: flex; gap: var(--space-2); align-items: center; justify-content: flex-end; font: 600 14px / 1 var(--font-sans); }
  .open-tag[data-state="closed"] { background: var(--jullay-forest); color: var(--jullay-cream); }
  .sound-toggle, .menu-link { color: var(--jullay-milk); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .sound-toggle[aria-pressed="true"] { text-decoration: underline; text-underline-offset: 4px; }
  .topbar :focus-visible { outline-color: var(--jullay-milk); }

  @media (max-width: 860px) {
    .topbar { grid-template-columns: auto 1fr; padding: 0 var(--space-2); height: 52px; }
    .topbar-logo { width: 72px; }
    .zones { position: fixed; left: 0; right: 0; bottom: 0; justify-content: center; padding: var(--space-1); background: var(--jullay-olive); }
    .plaque { font-size: 11px; letter-spacing: .1em; padding: 0 8px; height: 36px; }
    .open-tag { display: none; }
  }
</style>
